# 第三方实测凭据模板：复制为 .env 并填写（.env 已被 git 忽略，不会提交）
# 填好后告诉助手"跑实测"，或自行执行：node test/real-api.mjs
# 按需填写，缺省的项自动跳过。

# ---- OpenAI 兼容对话服务商 ----
DSWC_TEST_OPENAI_BASE_URL=
DSWC_TEST_OPENAI_KEY=
DSWC_TEST_OPENAI_MODEL=

# ---- Anthropic 兼容对话服务商（可选）----
DSWC_TEST_ANTHROPIC_BASE_URL=
DSWC_TEST_ANTHROPIC_KEY=
DSWC_TEST_ANTHROPIC_MODEL=

# ---- 生图服务（可选，OpenAI 兼容 images 端点）----
DSWC_TEST_IMAGE_ENDPOINT=
DSWC_TEST_IMAGE_KEY=
DSWC_TEST_IMAGE_MODEL=
DSWC_TEST_IMAGE_EDIT_MODEL=